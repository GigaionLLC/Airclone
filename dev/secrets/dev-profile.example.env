# =============================================================================
# Airclone — developer profile TEMPLATE
# =============================================================================
# Copy this file to `dev-profile.env` (same directory) and fill in YOUR OWN
# values:
#
#     cp dev/secrets/dev-profile.example.env dev/secrets/dev-profile.env
#
# `dev-profile.env` is gitignored and MUST NEVER be committed. This template is
# the only version that is committed, and it must never contain a real value.
#
# WHY THIS FILE EXISTS
# --------------------
# GigaionLLC/Airclone is a PUBLIC repository. Store publisher GUIDs, seller and
# tenant ids, D-U-N-S numbers, contact addresses and signing credentials must
# never appear in it — see wiki/core/17-docs-blueprint.md section 6. But local
# tooling and AI assistants still need those values to do real work (setting CI
# variables, filling a Partner Center form, hosting a release). This file is the
# one agreed place they live: outside git, inside the working tree.
#
# THESE VALUES BELONG TO ONE BUILDER
# ----------------------------------
# The maintainer's own `dev-profile.env` describes the Gigaion, LLC accounts. If
# you cloned this repo, that file is not yours and you will not have it. Copy
# this template and fill in your own publisher, team and signing identities.
# Anything you leave blank simply means "I do not have this lane set up" — no
# tooling should assume a value is present.
#
# CONVENTIONS
# -----------
#   PUBLIC   safe to appear in committed files (kept here only for convenience)
#   PRIVATE  identifier that should stay out of the public repo
#   SECRET   a credential — treat like a password; never echo it into a log
#
# `sync -> variable` / `sync -> secret` marks how a key reaches GitHub Actions.
# See dev/secrets/README.md for the sync commands.
# =============================================================================


# ─── Company / legal ─────────────────────────────────────────────────────────
# Used in store listings, installer publisher fields and certificate subjects.
COMPANY_LEGAL_NAME=                 # PUBLIC   e.g. "Example Co, LLC" (exact legal form)
COMPANY_WEBSITE=                    # PUBLIC   https://example.com
COMPANY_SUPPORT_EMAIL=              # PRIVATE  public-facing support contact
COMPANY_SUPPORT_ADDRESS=            # PRIVATE  the address shown on store listings
COMPANY_DUNS=                       # PRIVATE  D-U-N-S number, if you have one


# ─── Microsoft Store / Partner Center ────────────────────────────────────────
# Copy the first three VERBATIM from Partner Center -> your app ->
# Product management -> Product identity. All four identity fields are validated
# on upload and the FIRST failure masks the rest, so fix them as a set.
# Runbook: dev/windows-signing-and-store.md section 2c.
MSIX_IDENTITY_NAME=                 # PUBLIC   sync -> variable  Package/Identity/Name
MSIX_PUBLISHER=                     # PRIVATE  sync -> variable  Package/Identity/Publisher, "CN=<GUID>"
MSIX_DISPLAY_NAME=                  # PUBLIC   sync -> variable  must be a RESERVED app name
STORE_PUBLISHER_DISPLAY_NAME=       # PUBLIC   Package/Properties/PublisherDisplayName
STORE_APP_ID=                       # PRIVATE  sync -> variable  the Store ID (product id)
STORE_SELLER_ID=                    # PRIVATE  sync -> secret    Account settings -> Legal info
STORE_TENANT_ID=                    # PRIVATE  sync -> secret    Entra tenant id
STORE_CLIENT_ID=                    # PRIVATE  sync -> secret    Entra app registration id
STORE_CLIENT_SECRET=                # SECRET   sync -> secret    rotate this if it ever leaks
# Master switch for the automated `msstore publish` lane. Leave false until a
# manual submission has succeeded end to end.
STORE_PUBLISH_ENABLED=false         # PUBLIC   sync -> variable


# ─── Windows code signing (Azure Artifact Signing) ───────────────────────────
AZURE_SIGNING_PROFILE=              # PRIVATE  sync -> variable  certificate profile name
AZURE_SIGNING_ACCOUNT=              # PRIVATE  sync -> variable  signing account name
AZURE_SIGNING_ENDPOINT=             # PRIVATE  sync -> variable  e.g. https://<region>.codesigning.azure.net
AZURE_TENANT_ID=                    # PRIVATE  sync -> secret
AZURE_CLIENT_ID=                    # PRIVATE  sync -> secret
AZURE_CLIENT_SECRET=                # SECRET   sync -> secret
WINDOWS_SIGNING_ENABLED=false       # PUBLIC   sync -> variable  master switch


# ─── Apple (Developer ID signing + notarization, and App Store Connect) ─────
APPLE_TEAM_ID=                      # PRIVATE  sync -> secret    10-char Team ID
APPLE_DEVELOPER_ID_NAME=            # PRIVATE  "Developer ID Application: <Name> (<TeamID>)"
APPLE_NOTARY_APPLE_ID=              # PRIVATE  sync -> secret    the Apple ID e-mail used to notarize
APPLE_NOTARY_PASSWORD=              # SECRET   sync -> secret    app-specific password, NOT the account password

# App Store Connect API - drives TestFlight uploads and App Store submissions from
# CI. Minted at App Store Connect -> Users and Access -> Integrations -> Team Keys.
# Give the key the APP MANAGER role: enough to upload builds and manage versions,
# and deliberately NOT Admin, which would let a CI credential manage users, roles
# and agreements. These are set ORG-wide (visibility: all) because the same key
# serves every app the org ships, matching the other APPLE_* credentials.
APPSTORE_ISSUER_ID=                 # PRIVATE  sync -> variable  UUID, one per team
APPSTORE_API_KEY_ID=                # PRIVATE  sync -> variable  10-char Key ID, also in the .p8 filename
APPSTORE_API_PRIVATE_KEY_PATH=      # SECRET   ABSOLUTE path to AuthKey_<KeyID>.p8 - keep the file OUTSIDE
                                    #          this repo. Apple lets you download it EXACTLY ONCE and will
                                    #          never show it again; losing it means revoke and reissue.
                                    #          Sync with (redirect, never paste - keeps it out of
                                    #          shell history and out of any AI transcript):
                                    #            gh secret set APPSTORE_API_PRIVATE_KEY --org <org> --visibility all < "<path>"


# ─── Google Play ─────────────────────────────────────────────────────────────
PLAY_PACKAGE_NAME=                  # PUBLIC   the applicationId, e.g. com.example.app
PLAY_SERVICE_ACCOUNT_EMAIL=         # PRIVATE  service account used for the publishing API
PLAY_SERVICE_ACCOUNT_JSON_PATH=     # SECRET   ABSOLUTE path to the key file — keep the file OUTSIDE this repo


# ─── Android release signing ─────────────────────────────────────────────────
# The keystore itself lives outside the repo (.gitignore already blocks *.jks,
# *.keystore and key.properties anywhere in the tree). Store only the path here.
ANDROID_KEYSTORE_PATH=              # SECRET   ABSOLUTE path, outside the repo
ANDROID_KEY_ALIAS=                  # PRIVATE
ANDROID_KEYSTORE_PASSWORD=          # SECRET
ANDROID_KEY_PASSWORD=               # SECRET


# ─── Release hosting (the non-redirecting installer URL the Store points at) ─
# The Store rejects a Package URL that redirects, so the signed installer is
# self-hosted at a direct, versioned URL. See dev/windows-signing-and-store.md.
RELEASE_HOST=                       # PRIVATE  hostname of the web host
RELEASE_SSH_USER=                   # PRIVATE
RELEASE_REMOTE_PATH=                # PRIVATE  absolute path on that host
RELEASE_BASE_URL=                   # PUBLIC   e.g. https://example.com/releases/airclone
