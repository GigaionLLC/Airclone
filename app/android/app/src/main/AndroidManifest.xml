<manifest xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Cloud remotes: the bundled rclone engine talks to storage providers. -->
    <uses-permission android:name="android.permission.INTERNET"/>
    <!-- Scanning the desktop's "Send to phone" QR (config-portability plan §5).
         Requested in-flow the first time the scanner opens (never at launch);
         declared optional so the app still installs on camera-less devices. -->
    <uses-permission android:name="android.permission.CAMERA"/>
    <uses-feature android:name="android.hardware.camera" android:required="false"/>
    <!-- ANDROID TV. Both declarations are required="false" DELIBERATELY, and
         changing either to "true" is the one edit here that breaks the shipped
         app: Play reads leanback:required="true" as "this is a TV-ONLY app" and
         stops serving it to every phone and tablet it is installed on today. -->
    <uses-feature android:name="android.software.leanback" android:required="false"/>
    <!-- Android implicitly requires a touchscreen of every app that does not say
         otherwise, which is the single reason a TV cannot see Airclone today.
         Declaring it optional only ADDS eligible devices - it removes none. -->
    <uses-feature android:name="android.hardware.touchscreen" android:required="false"/>
    <!-- Transfers keep running when the app is backgrounded: a dataSync
         foreground service holds the process (and the engine child) alive,
         with a progress notification (runtime-granted on Android 13+). -->
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE"/>
    <uses-permission android:name="android.permission.FOREGROUND_SERVICE_DATA_SYNC"/>
    <uses-permission android:name="android.permission.POST_NOTIFICATIONS"/>
    <!-- Local files: rclone's `local` backend uses real filesystem paths, which
         on Android 11+ requires All Files Access (granted by the user from the
         in-app prompt; without it, browsing is limited to the app's own dir).
         Pre-11 devices use the legacy runtime permissions instead (plus
         requestLegacyExternalStorage for Android 10's scoped-storage opt-out). -->
    <uses-permission android:name="android.permission.MANAGE_EXTERNAL_STORAGE"/>
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="29"/>
    <uses-permission android:name="android.permission.WRITE_EXTERNAL_STORAGE"
        android:maxSdkVersion="29"/>
    <!-- allowBackup=false: the app dir holds rclone.conf (cloud credentials,
         obscured not encrypted) — it must never ride along in ADB/cloud
         backups or device-to-device transfers. -->
    <!-- networkSecurityConfig: cleartext stays denied everywhere except
         loopback, where the on-device rclone engine serves file bytes. Android's
         media stack (MediaMetadataRetriever, used for video thumbnails) enforces
         this policy even for 127.0.0.1 and silently reads nothing without it. -->
    <application
        android:label="airclone"
        android:name="${applicationName}"
        android:icon="@mipmap/ic_launcher"
        android:banner="@drawable/tv_banner"
        android:allowBackup="false"
        android:networkSecurityConfig="@xml/network_security_config"
        android:requestLegacyExternalStorage="true">
        <activity
            android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTop"
            android:taskAffinity=""
            android:theme="@style/LaunchTheme"
            android:configChanges="orientation|keyboardHidden|keyboard|screenSize|smallestScreenSize|locale|layoutDirection|fontScale|screenLayout|density|uiMode"
            android:hardwareAccelerated="true"
            android:windowSoftInputMode="adjustResize">
            <!-- Specifies an Android theme to apply to this Activity as soon as
                 the Android process has started. This theme is visible to the user
                 while the Flutter UI initializes. After that, this theme continues
                 to determine the Window background behind the Flutter UI. -->
            <meta-data
              android:name="io.flutter.embedding.android.NormalTheme"
              android:resource="@style/NormalTheme"
              />
            <intent-filter>
                <action android:name="android.intent.action.MAIN"/>
                <category android:name="android.intent.category.LAUNCHER"/>
                <!-- Puts the app in the Android TV launcher. Phones and tablets
                     ignore a category they have no launcher for, so one activity
                     serves both form factors and there is no second variant. -->
                <category android:name="android.intent.category.LEANBACK_LAUNCHER"/>
            </intent-filter>
        </activity>
        <!-- "Open in another app": open_external.dart stages a cloud object in
             the app cache, then MainActivity mints a content:// URI for it here
             and attaches a one-shot read grant to the chooser Intent. A raw
             file:// Uri would throw FileUriExposedException. exported=false —
             only our own grants let anything else read it, and file_paths.xml
             scopes it to the staging dir alone (never rclone.conf). -->
        <provider
            android:name="androidx.core.content.FileProvider"
            android:authorities="${applicationId}.fileprovider"
            android:exported="false"
            android:grantUriPermissions="true">
            <meta-data
                android:name="android.support.FILE_PROVIDER_PATHS"
                android:resource="@xml/file_paths" />
        </provider>
        <!-- Holds the app (and the engine child process) alive while transfers
             run in the background. Started/stopped from Dart. -->
        <service
            android:name=".TransferService"
            android:exported="false"
            android:foregroundServiceType="dataSync" />
        <!-- Don't delete the meta-data below.
             This is used by the Flutter tool to generate GeneratedPluginRegistrant.java -->
        <meta-data
            android:name="flutterEmbedding"
            android:value="2" />
    </application>
    <!-- Required to query activities that can process text, see:
         https://developer.android.com/training/package-visibility and
         https://developer.android.com/reference/android/content/Intent#ACTION_PROCESS_TEXT.

         In particular, this is used by the Flutter engine in io.flutter.plugin.text.ProcessTextPlugin. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.PROCESS_TEXT"/>
            <data android:mimeType="text/plain"/>
        </intent>
        <!-- "Open in another app" launches VIEW/SEND choosers for a staged
             file. The chooser itself is system-resolved, but declaring the
             intents keeps resolution predictable under Android 11+ package
             visibility. -->
        <intent>
            <action android:name="android.intent.action.VIEW"/>
            <data android:mimeType="*/*"/>
        </intent>
        <intent>
            <action android:name="android.intent.action.SEND"/>
            <data android:mimeType="*/*"/>
        </intent>
    </queries>
</manifest>
