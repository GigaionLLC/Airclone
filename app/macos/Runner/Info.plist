<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>CFBundleDevelopmentRegion</key>
	<string>$(DEVELOPMENT_LANGUAGE)</string>
	<key>CFBundleExecutable</key>
	<string>$(EXECUTABLE_NAME)</string>
	<key>CFBundleIconFile</key>
	<string></string>
	<key>CFBundleIdentifier</key>
	<string>$(PRODUCT_BUNDLE_IDENTIFIER)</string>
	<key>CFBundleInfoDictionaryVersion</key>
	<string>6.0</string>
	<key>CFBundleName</key>
	<string>$(PRODUCT_NAME)</string>
	<key>CFBundlePackageType</key>
	<string>APPL</string>
	<key>CFBundleShortVersionString</key>
	<string>$(FLUTTER_BUILD_NAME)</string>
	<key>CFBundleVersion</key>
	<string>$(FLUTTER_BUILD_NUMBER)</string>
	<!-- Required by the App Store: validation rejects the package with error
	     90242 without it. Must match the primary category chosen in App Store
	     Connect, which is Utilities. Harmless for the direct-download build. -->
	<key>LSApplicationCategoryType</key>
	<string>public.app-category.utilities</string>
	<key>LSMinimumSystemVersion</key>
	<string>$(MACOSX_DEPLOYMENT_TARGET)</string>
	<key>NSHumanReadableCopyright</key>
	<string>$(PRODUCT_COPYRIGHT)</string>
	<key>NSMainNibFile</key>
	<string>MainMenu</string>
	<key>NSCameraUsageDescription</key>
	<string>Airclone uses the camera only to scan an Offline QR code when you choose Import QR Config, so a configuration can move between your devices without going through any server.</string>
	<key>NSPrincipalClass</key>
	<string>NSApplication</string>
	<!-- Export compliance, answered here so Apple never asks per build.
	     FALSE means "does not use NON-EXEMPT encryption" - not "uses no
	     encryption". Airclone does encrypt: rclone's crypt backend, the config
	     passphrase, Argon2id, and TLS from the statically linked engine. All of
	     it is published, standard cryptography, which is exempt.
	     Apple itself enforces the boundary: POST /v1/appEncryptionDeclarations
	     is REFUSED unless the app uses proprietary cryptography, or uses
	     third-party cryptography AND is sold in France. Neither is true here, so
	     there is no declaration to make and the use is exempt.
	     THIS DEPENDS ON FRANCE STAYING EXCLUDED. Adding the French store makes a
	     declaration required and this key a false statement - see
	     dev/plans/apple-appstore-plan.md before changing availability. -->
	<key>ITSAppUsesNonExemptEncryption</key>
	<false/>
</dict>
</plist>
