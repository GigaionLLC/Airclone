<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<!-- No App Sandbox: Airclone spawns a user-provisioned rclone binary, binds
	     loopback sockets, and reads/writes arbitrary user paths — none of which the
	     sandbox permits. Developer ID (non-App-Store) distribution does not require
	     it; the Hardened Runtime (Release.xcconfig + CI codesign) is what notarization
	     checks. -->
	<key>com.apple.security.app-sandbox</key>
	<false/>
	<!-- The built-in camera, for scanning an Offline QR to import a config
	     (Settings -> Import QR Config). Under the Hardened Runtime a macOS app
	     cannot open a capture device without this, and NSCameraUsageDescription
	     in Info.plist supplies the prompt the user sees. Direct-download build
	     only: the Mac App Store entitlements deliberately omit it until that
	     submission decision is taken - see MacAppStore.entitlements. -->
	<key>com.apple.security.device.camera</key>
	<true/>
</dict>
</plist>
