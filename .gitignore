# ─── External reference material (NEVER commit) ────────────────────────────
# Competitive research notes, clones, screenshots, and feature breakdowns of
# third-party projects, plus the documentation-methodology source. Kept locally
# so we can learn from them without shipping external resources in our repo.
/reference/

# Vendored agent/dev skills (their own third-party permissive licenses). Dev
# tooling only — not part of the shipped app. Kept locally, out of this repo.
/Skills/

# ─── Dependencies / build output ───────────────────────────────────────────
node_modules/
dist/
dist-ssr/
build/
out/
target/
.output/
*.local

# ─── Flutter / Dart ────────────────────────────────────────────────────────
# (app/.gitignore covers most of these within app/; these are repo-wide guards.)
/.pub-cache/
.pub-cache/
.dart_tool/
.flutter-plugins
.flutter-plugins-dependencies
**/windows/flutter/ephemeral/
**/linux/flutter/ephemeral/
**/macos/Flutter/ephemeral/
*.iml

# ─── Android bundled engine (built artifact, never commit) ─────────────────
# dev/android/build-rclone.ps1 (local) / release.yml (CI) cross-compile rclone
# into jniLibs as a per-ABI executable named librclone.so.
app/android/app/src/main/jniLibs/

# ─── Desktop in-process engine (built librclone, never commit) ─────────────
# dev/desktop/build-librclone.{ps1,sh} (local) / release.yml (CI) build rclone
# as a c-shared lib; CMake/build bundles it next to the app. ~60MB artifact.
app/windows/librclone/
app/macos/librclone/
app/linux/librclone/

# ─── Android release signing (SECRETS — never commit) ──────────────────────
# The release keystore lives outside the repo (~/.airclone-signing); these
# guards make sure a stray copy or the key.properties that points at it can
# never be checked in. CI injects the same values via AIRCLONE_* secrets.
**/key.properties
*.jks
*.keystore

# ─── Tauri / Rust (if adopted) ─────────────────────────────────────────────
src-tauri/target/
**/*.rs.bk

# ─── Editor / OS ───────────────────────────────────────────────────────────
.DS_Store
Thumbs.db
.vscode/*
!.vscode/extensions.json
!.vscode/settings.json
.idea/

# ─── Logs / env ────────────────────────────────────────────────────────────
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.env
.env.*
!.env.example

# ─── Local developer profile (PII + account identifiers — NEVER commit) ────
# dev/secrets/ holds ONE builder's real account values (publisher GUIDs, seller
# and tenant ids, D-U-N-S, contact address, signing credentials) so tooling and
# AI assistants have them locally without them ever entering this PUBLIC repo.
# NOTE the rules above do NOT cover these: `.env`/`.env.*` only match a dotfile
# basename, so `dev-profile.env` would have been committed.
# Deny the whole directory, then re-allow only the committed template + docs.
dev/secrets/*
!dev/secrets/README.md
!dev/secrets/dev-profile.example.env
# Belt-and-braces: these names are never committable from anywhere in the tree.
*.secret.env
dev-profile.env
*.env.enc
.passphrase

# Byte-code from the tool/ scripts (play_promote, play_tracks, store_submit).
__pycache__/
*.pyc
